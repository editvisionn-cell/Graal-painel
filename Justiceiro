btnSalvar.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {char}
        params.FilterType = Enum.RaycastFilterType.Exclude
        local raio = workspace:Raycast(hrp.Position, Vector3.new(0, -50, 0), params)
        local chao = raio and raio.Position or hrp.Position
        
        state.posicoesSalvas[state.slotSelecionado] = chao
        btnSalvar.Text = "✔ Salvo no Slot " .. state.slotSelecionado .. "!"
        task.delay(2, function() btnSalvar.Text = "💾 Salvar no Slot " .. state.slotSelecionado end)
    end
end)

btnTP.MouseButton1Click:Connect(function()
    local chaoSalvo = state.posicoesSalvas[state.slotSelecionado]
    if not chaoSalvo then return end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(Vector3.new(chaoSalvo.X, chaoSalvo.Y + 3, chaoSalvo.Z))
        char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
        char.Humanoid:ChangeState(Enum.HumanoidStateType.Landed)
    end
end)

-- ================= SLIDER DE VELOCIDADE =================
local MIN_SPEED, MAX_SPEED = 16, 1000
local dragging = false

local function updateSlider(inputX)
    local pos = math.clamp(inputX - sliderBg.AbsolutePosition.X, 0, sliderBg.AbsoluteSize.X)
    local ratio = pos / sliderBg.AbsoluteSize.X
    local value = math.floor(MIN_SPEED + (MAX_SPEED - MIN_SPEED) * ratio + 0.5)
    fill.Size = UDim2.new(ratio, 0, 1, 0)
    knob.Position = UDim2.new(ratio, 0, 0.5, 0)
    state.velocidadeAtual = value
    if state.speedAtivo then btnSpeedToggle.Text = "⚡ Speed (Bypass): ON (" .. value .. ")" end
end

knob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSlider(input.Position.X) end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)

-- ================= ARRASTAR PAINEL =================
local draggingPanel, dragStart, startPos
header.InputBegan:Connect(function(input) 
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
        draggingPanel, dragStart, startPos = true, input.Position, painel.Position 
    end 
end)
UserInputService.InputChanged:Connect(function(input)
    if draggingPanel and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        painel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input) 
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
        draggingPanel = false 
    end 
end)

-- ================= LOOPS DE JOGO =================
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Noclip e Speed
    if state.noclipAtivo then
        for _, parte in ipairs(char:GetDescendants()) do
            if parte:IsA("BasePart") then parte.CanCollide = false end
        end
        if hrp.AssemblyLinearVelocity.Magnitude > 100 then
            hrp.AssemblyLinearVelocity = hrp.CFrame.LookVector * 16 
        end
    end

    if state.speedAtivo and not state.noclipAtivo then
        hum.WalkSpeed = 16 
        if hrp.AssemblyLinearVelocity.Magnitude > 1 then
            hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * ((state.velocidadeAtual - 16) * 0.025))
        end
    elseif state.speedAtivo and state.noclipAtivo then
        hum.WalkSpeed = state.velocidadeAtual
    end

    -- Elevador
    if state.plataformaAtiva then
        if not state.plataformaAtual or not state.plataformaAtual.Parent then
            local plat = Instance.new("Part")
            plat.Size = Vector3.new(8, 1, 8)
            plat.Anchored = true
            plat.CanCollide = true
            plat.Material = Enum.Material.Neon
            plat.Color = CORES.Destaque
            plat.Transparency = 0.5
            plat.Parent = workspace
            state.plataformaAtual = plat
        end
        state.plataformaAtual.CFrame = CFrame.new(Vector3.new(hrp.Position.X, hrp.Position.Y - 3, hrp.Position.Z))
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, state.forcaSubida, hrp.AssemblyLinearVelocity.Z)
    elseif state.plataformaAtual then
        state.plataformaAtual:Destroy()
        state.plataformaAtual = nil
    end
end)

-- Loop Farm
task.spawn(function()
    while task.wait(0.03) do 
        if not state.autoAttackAtivo and not state.hitboxAtivo then continue end
        local char = LocalPlayer.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then continue end

        local arma = char:FindFirstChildOfClass("Tool")
        if arma then
            pcall(function()
                if arma:FindFirstChild("Cooldown") then arma.Cooldown.Value = 0 end
            end)
        end

        local partesNoRaio = workspace:GetPartBoundsInRadius(hrp.Position, 80)
        local alvo = nil
        local menorDist = 9999

        for _, parte in ipairs(partesNoRaio) do
            local modelo = parte:FindFirstAncestorOfClass("Model")
            if modelo and modelo ~= char then
                local npcHum = modelo:FindFirstChildOfClass("Humanoid")
                local npcHrp = modelo:FindFirstChild("HumanoidRootPart") or modelo:FindFirstChild("Torso")
                if npcHum and npcHum.Health > 0 and npcHrp and not Players:GetPlayerFromCharacter(modelo) then
                    if state.hitboxAtivo then
                        if not hitboxOriginais[modelo] then hitboxOriginais[modelo] = npcHrp.Size end
                        npcHrp.Size = Vector3.new(30, 30, 30)
                        npcHrp.Transparency = 0.5
                    end
                    local dist = (npcHrp.Position - hrp.Position).Magnitude
                    if dist < menorDist then menorDist = dist; alvo = modelo end
                end
            end
        end

        if state.autoAttackAtivo and alvo then
            if not arma then
                local mochila = LocalPlayer:FindFirstChildOfClass("Backpack")
                if mochila then
                    local ferramenta = mochila:FindFirstChildWhichIsA("Tool")
                    if ferramenta then hum:EquipTool(ferramenta); arma = ferramenta end
                end
            end
            if arma then
                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    if track.Priority == Enum.AnimationPriority.Action then track:Stop() end
                end
                arma:Activate()
            end
        end
    end
end)
