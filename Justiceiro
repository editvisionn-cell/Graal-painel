local function novo(classe, props, parent)
    local o = Instance.new(classe)
    for k, v in pairs(props or {}) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

local function arredondar(obj, r)
    novo("UICorner", { CornerRadius = UDim.new(0, r or 6) }, obj)
end

local function animarBotao(btn, entrar)
    local corAlvo = entrar and CORES.BotaoHover or CORES.BotaoInativo
    local tamanhoAlvo = entrar and UDim2.new(1.02, 0, 0, 36) or UDim2.new(1, 0, 0, 36)
    TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundColor3 = corAlvo, Size = tamanhoAlvo}):Play()
end

