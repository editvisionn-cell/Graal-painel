-- ================= LOOP PRINCIPAL =================
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Noclip
    if state.noclipAtivo then
        for _, parte in ipairs(char:GetDescendants()) do
            if parte:IsA("BasePart") then parte.CanCollide = false end
        end
    end

    -- Speed Bypass
    if state.speedAtivo and not state.noclipAtivo then
        hum.WalkSpeed = 16 
        if hrp.AssemblyLinearVelocity.Magnitude > 1 then
            hrp.CFrame = hrp.CFrame + (hrp.CFrame.LookVector * ((state.velocidadeAtual - 16) * 0.025))
        end
    elseif state.speedAtivo and state.noclipAtivo then
        hum.WalkSpeed = state.velocidadeAtual
    end

    -- Elevador
    if state.plataformaAtiva then
        if not state.plataformaAtual or not state.plataformaAtual.Parent then
            local plat = Instance.new("Part")
            plat.Size = Vector3.new(8, 1, 8)
            plat.Anchored = true
            plat.CanCollide = true
            plat.Material = Enum.Material.Neon
            plat.Color = CORES.Destaque
            plat.Transparency = 0.5
            plat.Parent = workspace
            state.plataformaAtual = plat
        end
        state.plataformaAtual.CFrame = CFrame.new(Vector3.new(hrp.Position.X, hrp.Position.Y - 3, hrp.Position.Z))
        hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, state.forcaSubida, hrp.AssemblyLinearVelocity.Z)
    elseif state.plataformaAtual then
        state.plataformaAtual:Destroy()
        state.plataformaAtual = nil
    end
end)

-- ================= LOOP AUTO-SNIPE (ROUBAR OVO) =================
task.spawn(function()
    while task.wait(0.1) do
        if state.autoSnipeAtivo then
            local char = LocalPlayer.Character
            if not char then continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end

            -- 1. Procura o ovo mais próximo (que tenha "Egg" ou "Ovo" no nome)
            local ovosNoMapa = workspace:GetDescendants()
            local ovoAlvo = nil
            local menorDist = 9999

            for _, obj in ipairs(ovosNoMapa) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    local nome = string.lower(obj.Name)
                    if (string.find(nome, "egg") or string.find(nome, "ovo")) and not obj:FindFirstAncestorOfClass("Model") then
                        local pos = obj:IsA("BasePart") and obj.Position or (obj:FindFirstChild("HumanoidRootPart") and obj.HumanoidRootPart.Position)
                        if pos then
                            local dist = (pos - hrp.Position).Magnitude
                            if dist < menorDist then
                                menorDist = dist
                                ovoAlvo = obj
                            end
                        end
                    end
                end
            end

            -- 2. Se achou o ovo, faz o Teleporte Snipe e Coleta
            if ovoAlvo then
                local posOvo = ovoAlvo:IsA("BasePart") and ovoAlvo.Position or (ovoAlvo:FindFirstChild("HumanoidRootPart") and ovoAlvo.HumanoidRootPart.Position)
                
                if posOvo then
                    -- Teleporta para o ovo
                    hrp.CFrame = CFrame.new(posOvo + Vector3.new(0, 3, 0))
                    
                    -- Procura o botão de coletar (ProximityPrompt)
                    local prompt = ovoAlvo:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        fireproximityprompt(prompt)
                    end

                    -- 3. Volta para a base (se tiver salvo)
                    if state.posicoesSalvas[1] then
                        task.wait(0.1) -- Pequeno delay para o jogo registrar que você pegou
                        hrp.CFrame = state.posicoesSalvas[1]
                        
                        -- Anula o "Modo Lento" que o jogo coloca quando você pega o ovo
                        hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
                    end
                end
            end
        end
    end
end)

-- ================= LOOP AUTO-FARM (BATER) =================
task.spawn(function()
    while task.wait(0.05) do 
        if not state.autoAttackAtivo and not state.hitboxAtivo then continue end
        
        local char = LocalPlayer.Character
        if not char then continue end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then continue end

        local arma = char:FindFirstChildOfClass("Tool")
        if arma then
            pcall(function()
                if arma:FindFirstChild("Cooldown") then arma.Cooldown.Value = 0 end
            end)
        end

        local partesNoRaio = workspace:GetPartBoundsInRadius(hrp.Position, 80)
        local alvo = nil
        local menorDist = 9999

        for _, parte in ipairs(partesNoRaio) do
            local modelo = parte:FindFirstAncestorOfClass("Model")
            if modelo and modelo ~= char then
                local npcHum = modelo:FindFirstChildOfClass("Humanoid")
                local npcHrp = modelo:FindFirstChild("HumanoidRootPart") or modelo:FindFirstChild("Torso")
                
                if npcHum and npcHum.Health > 0 and npcHrp and not Players:GetPlayerFromCharacter(modelo) then
                    if state.hitboxAtivo then
                        if not hitboxOriginais[modelo] then hitboxOriginais[modelo] = npcHrp.Size end
                        npcHrp.Size = Vector3.new(30, 30, 30)
                        npcHrp.Transparency = 0.5
                    end
                    
                    local dist = (npcHrp.Position - hrp.Position).Magnitude
                    if dist < menorDist then
                        menorDist = dist
                        alvo = modelo
                    end
                end
            end
        end

        if state.autoAttackAtivo and alvo then
            if not arma then
                local mochila = LocalPlayer:FindFirstChildOfClass("Backpack")
                if mochila then
                    local ferramenta = mochila:FindFirstChildWhichIsA("Tool")
                    if ferramenta then hum:EquipTool(ferramenta); arma = ferramenta end
                end
            end
            
            if arma then
                for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                    if track.Priority == Enum.AnimationPriority.Action then track:Stop() end
                end
                arma:Activate()
            end
        end
    end
end)
