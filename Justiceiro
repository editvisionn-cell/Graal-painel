        TweenService:Create(menuFarm, TweenInfo.new(0.2), {BackgroundColor3 = CORES.BotaoAtivo, TextColor3 = CORES.Texto}):Play()
        TweenService:Create(menuPlayer, TweenInfo.new(0.2), {BackgroundColor3 = CORES.BotaoInativo, TextColor3 = CORES.TextoSub}):Play()
    end
end

