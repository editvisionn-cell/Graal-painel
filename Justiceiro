local function criarBotaoMenu(nome, icone, layoutOrder)
    local btn = novo("TextButton", {
        Size = UDim2.new(0.9, 0, 0, 35),
        BackgroundColor3 = CORES.BotaoInativo,
        Text = icone .. " " .. nome,
        TextColor3 = CORES.TextoSub,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        LayoutOrder = layoutOrder,
    }, sidebar)
    arredondar(btn, 6)
    btn.MouseEnter:Connect(function() animarBotao(btn, true) end)
    btn.MouseLeave:Connect(function() animarBotao(btn, false) end)
    return btn
end

